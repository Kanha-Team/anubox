# AnuBox Configuration

# Maximum file upload size in MB (Default: 100)
MAX_SIZE_MB=100

# Require authentication for uploading (true/false)
ENABLE_AUTH=false

# Master secret key for AES-256-GCM chunk encryption
ENCRYPTION_KEY=anubox_secret_master_encryption_key_2026_xyz

# Admin Dashboard credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Telegram Cloud Storage (Optional - falls back to local storage)
BOT_TOKEN=
BOT_CHAT_ID=
BOT_ADMIN_IDS=
