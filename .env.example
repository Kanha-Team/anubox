# AnuBox Configuration

# Maximum file upload size in MB (Default: 100)
MAX_SIZE_MB=100

# Require authentication for uploading (true/false)
ENABLE_AUTH=false

# Master secret key for AES-256-GCM chunk encryption & token signing (Set your own secure random key)
ENCRYPTION_KEY=
ADMIN_SESSION_SECRET=

# Admin Dashboard credentials (Required to access /admin - set your own strong credentials)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Telegram Cloud Storage (Optional - falls back to local storage)
BOT_TOKEN=
BOT_CHAT_ID=
BOT_ADMIN_IDS=

# MongoDB Database (Recommended for Vercel Serverless deployments to persist files across lambda instances)
MONGODB_URI=
MONGO_DB_NAME=anubox
